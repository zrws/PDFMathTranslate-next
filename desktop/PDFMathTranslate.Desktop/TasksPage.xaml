<Page x:Class="PDFMathTranslate.Desktop.TasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="任务队列" Background="Transparent">
  <Grid Margin="20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><TextBlock DockPanel.Dock="Right" Text="{Binding Store.Summary}" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="Heading" Text="任务队列" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="工作台与队列使用同一份实时进度。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <DataGrid Grid.Row="1" x:Name="TaskGrid" ItemsSource="{Binding Store.Tasks}" SelectedItem="{Binding SelectedTask,Mode=OneWay}" SelectionChanged="TaskSelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" RowHeight="48" AutomationProperties.Name="翻译任务列表">
      <DataGrid.Columns><DataGridTextColumn Header="文档" Binding="{Binding Filename,Mode=OneWay}" Width="2*" MinWidth="160"/><DataGridTextColumn Header="语言" Binding="{Binding Languages,Mode=OneWay}" Width="130"/><DataGridTextColumn Header="状态" Binding="{Binding StatusLabel,Mode=OneWay}" Width="90"/><DataGridTextColumn Header="当前阶段" Binding="{Binding Stage,Mode=OneWay}" Width="*" MinWidth="120"/><DataGridTextColumn Header="进度" Binding="{Binding Progress,Mode=OneWay,StringFormat={}{0:F0}%}" Width="80"/></DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" Padding="12" Margin="0,12,0,12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><ScrollViewer MaxHeight="148" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectedTask.Detail}" TextWrapping="Wrap" AutomationProperties.Name="选中任务详情"/></ScrollViewer></Border>
    <WrapPanel Grid.Row="3"><Button Content="取消任务" Command="{Binding CancelCommand}"/><Button Content="按原配置重试" Command="{Binding RetryCommand}"/><Button Content="保存结果" Command="{Binding ExportCommand}"/><Button Content="打开结果目录" Click="OpenFolderClicked"/><Button Content="打开 PDF" Click="OpenFileClicked"/><Button Content="更多历史" Command="{Binding MoreHistoryCommand}"/><Button Content="清除终态历史" Command="{Binding ClearHistoryCommand}"/></WrapPanel>
  </Grid>
</Page>
