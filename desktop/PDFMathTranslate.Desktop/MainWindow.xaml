<ui:FluentWindow x:Class="PDFMathTranslate.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:PDFMathTranslate.Desktop"
 Title="PDFMathTranslate Next" Width="1380" Height="920" MinWidth="980" MinHeight="680"
 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
 FontFamily="Microsoft YaHei UI" FontSize="14">
 <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="PDFMathTranslate Next" Height="42"/>
  <Grid Grid.Row="1" Margin="24,8,24,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <ui:SymbolIcon Symbol="Translate24" FontSize="26" Margin="0,0,12,0"/>
    <StackPanel><ui:TextBlock Text="PDFMathTranslate Next" FontTypography="BodyStrong"/><ui:TextBlock Text="论文翻译，公式与排版如初" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,20,0">
    <ui:TextBlock Text="{Binding ServiceState}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
    <ui:TextBlock Text="{Binding SyncState}" FontTypography="Caption" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <ui:Button x:Name="TopSaveButton" Content="保存设置" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0"/>
    <ui:Button Content="{Binding Appearance.ThemeAction}" Icon="{ui:SymbolIcon WeatherMoon24}" Command="{Binding Appearance.ToggleThemeCommand}" Margin="0,0,8,0"/>
    <ui:HyperlinkButton Content="GitHub" Foreground="{DynamicResource TextFillColorPrimaryBrush}" NavigateUri="https://github.com/zrws/PDFMathTranslate-next"/>
   </StackPanel>
  </Grid>
  <ui:NavigationView x:Name="Navigation" Grid.Row="2" PaneDisplayMode="Left"
    IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" OpenPaneLength="216"
    Transition="None">
   <ui:NavigationView.PaneHeader><ui:TextBlock Text="工作区" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="24,16,0,12"/></ui:NavigationView.PaneHeader>
   <ui:NavigationView.MenuItems>
    <ui:NavigationViewItem Content="翻译工作台" Icon="{ui:SymbolIcon Translate24}" TargetPageType="{x:Type local:WorkbenchPage}"/>
    <ui:NavigationViewItem Content="文档输出" Icon="{ui:SymbolIcon FolderOpen24}" TargetPageType="{x:Type local:ResultsPage}"/>
    <ui:NavigationViewItem Content="术语表" Icon="{ui:SymbolIcon BookOpen24}" TargetPageType="{x:Type local:GlossaryPage}"/>
    <ui:NavigationViewItem Content="任务队列" Icon="{ui:SymbolIcon TaskListSquareLtr24}" TargetPageType="{x:Type local:TasksPage}"/>
    <ui:NavigationViewItem Content="设置" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type local:SettingsPage}"/>
   </ui:NavigationView.MenuItems>
   <ui:NavigationView.PaneFooter>
    <StackPanel Margin="20,12,20,20">
     <ui:TextBlock Text="本机工作区" FontTypography="BodyStrong"/>
     <ui:TextBlock Text="{Binding Store.Summary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Margin="0,6,0,0" TextWrapping="Wrap"/>
     <ui:TextBlock Text="{Binding VersionDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </ui:NavigationView.PaneFooter>
  </ui:NavigationView>
  <ui:InfoBar Grid.Row="3" Margin="16,8,16,12" IsOpen="True" IsClosable="False" Severity="Informational"
    Message="{Binding Notice}" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</ui:FluentWindow>
