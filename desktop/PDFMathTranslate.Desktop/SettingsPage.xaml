<Page x:Class="PDFMathTranslate.Desktop.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:xf="clr-namespace:XamlFlair;assembly=XamlFlair.WPF"
 Title="设置" Background="Transparent">
 <Grid Margin="24,16,24,12" xf:Animations.Primary="{Binding Appearance.EntranceAnimation}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><ui:TextBlock Text="设置" FontTypography="Title"/><ui:TextBlock Text="配置翻译引擎、保存位置和应用偏好。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel MaxWidth="1000" Margin="0,0,4,0" HorizontalAlignment="Stretch">
    <ui:CardExpander Icon="{ui:SymbolIcon Translate24}" IsExpanded="True" Margin="0,0,0,16">
     <ui:CardExpander.Header><StackPanel><ui:TextBlock Text="渠道管理" FontTypography="BodyStrong"/><ui:TextBlock Text="{Binding ActiveChannelName,StringFormat=当前使用：{0}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption"/></StackPanel></ui:CardExpander.Header>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
       <DockPanel Margin="0,0,0,12"><ui:Button DockPanel.Dock="Right" Content="新建" Command="{Binding NewChannelCommand}"/><ui:TextBlock Text="已保存渠道" FontTypography="BodyStrong" VerticalAlignment="Center"/></DockPanel>
       <ListBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel,Mode=TwoWay}" MinHeight="160" MaxHeight="280" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="已保存渠道">
        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis"/><ui:TextBlock Text="{Binding Summary}" FontTypography="Caption" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <ui:Button Content="使用已保存配置" Command="{Binding ActivateChannelCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,8"/>
       <ui:Button Content="删除所选渠道" Command="{Binding DeleteChannelCommand}" Appearance="Transparent" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <ui:TextBlock Text="渠道名称" Margin="0,0,0,6"/>
       <ui:TextBox Text="{Binding ChannelName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如：主用中转、本地模型、备用渠道" AutomationProperties.Name="渠道名称"/>
       <ui:TextBlock Text="翻译引擎" Margin="0,12,0,6"/>
       <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding Service,Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="翻译服务"/>
       <ui:TextBlock Text="API 地址" Margin="0,12,0,6"/>
       <ui:TextBox Text="{Binding BaseUrl,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="兼容地址一般以 /v1 结尾" AutomationProperties.Name="API 地址"/>
       <ui:TextBlock Text="API 密钥" Margin="0,12,0,6"/>
       <ui:PasswordBox x:Name="ApiKey" PasswordChanged="KeyChanged" RevealButtonEnabled="False" PlaceholderText="留空保留本渠道密钥" AutomationProperties.Name="新的 API 密钥"/>
       <ui:TextBlock Text="{Binding ApiKeyState}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,8"/>
       <ui:ToggleSwitch Content="清除此渠道已存密钥" IsChecked="{Binding ClearChannelKey,Mode=TwoWay}" Margin="0,0,0,12"/>
       <ui:TextBlock Text="模型（可探测，也可手动输入）" Margin="0,0,0,6"/>
       <ComboBox x:Name="ModelInput" ItemsSource="{Binding DetectedModels}" Text="{Binding Model,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="False" HorizontalAlignment="Stretch" AutomationProperties.Name="模型名称"/>
       <WrapPanel Margin="0,12,0,4"><ui:Button Content="探测模型" Command="{Binding DiscoverModelsCommand}" Margin="0,0,8,8"/><ui:Button Content="测试渠道" Command="{Binding TestChannelCommand}" Margin="0,0,8,8"/><ui:Button Content="保存并使用" Appearance="Primary" Command="{Binding SaveChannelCommand}" Margin="0,0,0,8"/></WrapPanel>
       <ui:TextBlock Text="测试发送一条简短请求；探测草稿不会切换当前渠道。" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
       <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{Binding ChannelState}" Margin="0,12,0,0"/>
      </StackPanel>
     </Grid>
    </ui:CardExpander>
    <ui:TextBlock Text="资源与性能" FontTypography="BodyStrong" Margin="0,4,0,10"/>
    <ui:CardControl Icon="{ui:SymbolIcon FlashSettings24}" Margin="0,0,0,8">
     <ui:CardControl.Header><StackPanel><ui:TextBlock Text="运行档位" FontTypography="BodyStrong"/><ui:TextBlock Text="文档逐份处理，控制本地计算线程。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption"/></StackPanel></ui:CardControl.Header>
     <ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}" Width="160" AutomationProperties.Name="资源档位"/>
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,0,8">
     <ui:CardControl.Header><StackPanel><ui:TextBlock Text="远程请求频率" FontTypography="BodyStrong"/><ui:TextBlock Text="每秒请求数（QPS），与本地线程分别限制。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption"/></StackPanel></ui:CardControl.Header>
     <ui:TextBox Text="{Binding Qps,UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="请求 QPS"/>
    </ui:CardControl>
    <ui:CardExpander Icon="{ui:SymbolIcon ArrowDownload24}" IsExpanded="True" Margin="0,0,0,16">
     <ui:CardExpander.Header><StackPanel><ui:TextBlock Text="翻译资源" FontTypography="BodyStrong"/><ui:TextBlock Text="{Binding AssetsState}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" MaxWidth="560"/></StackPanel></ui:CardExpander.Header>
     <StackPanel>
      <ProgressBar Value="{Binding AssetsProgress,Mode=OneWay}" Maximum="100" Height="5" Margin="0,0,0,12"/>
      <WrapPanel><ui:Button Content="准备 / 重试资源" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding PrepareAssetsCommand}" Margin="0,0,8,8"/><ui:Button Content="取消准备" Command="{Binding CancelAssetsCommand}" Margin="0,0,8,8"/><ui:Button Content="重试启动服务" Command="{Binding RestartServiceCommand}" Margin="0,0,0,8"/></WrapPanel>
      <ui:TextBlock Text="{Binding EffectivePolicy}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap"/>
     </StackPanel>
    </ui:CardExpander>
    <ui:TextBlock x:Name="StorageSection" Text="保存与数据" FontTypography="BodyStrong" Margin="0,4,0,10"/>
    <ui:Card Padding="20" Margin="0,0,0,8">
     <StackPanel>
      <DockPanel><ui:SymbolIcon Symbol="FolderOpen24" DockPanel.Dock="Left" Margin="0,0,10,0"/><ui:TextBlock Text="默认保存目录" FontTypography="BodyStrong"/></DockPanel>
      <Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ui:TextBox Text="{Binding SaveDirectory,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="选择译文保存位置" AutomationProperties.Name="默认保存目录"/>
       <ui:Button Grid.Column="1" Content="选择目录" Icon="{ui:SymbolIcon FolderOpen24}" Click="ChooseFolder" Margin="8,0,0,0"/>
      </Grid>
      <ui:ToggleSwitch Content="直接保存到每份源 PDF 旁边" IsChecked="{Binding UseSourceDirectory,Mode=TwoWay}" Margin="0,4,0,12"/>
      <ui:TextBlock Text="自定义目录按文章建文件夹；源目录模式直接放在 PDF 旁。重名时保留新版本。" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
      <ui:Button Content="保存目录与方式" Command="{Binding SaveDirectoryCommand}" Margin="0,12,0,0"/>
     </StackPanel>
    </ui:Card>
    <ui:CardExpander Icon="{ui:SymbolIcon DocumentCopy24}" IsExpanded="False" Margin="0,0,0,16">
     <ui:CardExpander.Header><StackPanel><ui:TextBlock Text="应用数据与待同步操作" FontTypography="BodyStrong"/><ui:TextBlock Text="卸载时保留设置、历史与用户导出文件。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption"/></StackPanel></ui:CardExpander.Header>
     <StackPanel>
      <ui:TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>
      <WrapPanel><ui:Button Content="重试待同步操作" Command="{Binding ResumePendingCommand}" Margin="0,0,8,8"/><ui:Button Content="清除待同步记录…" Command="{Binding DismissPendingCommand}" Margin="0,0,0,8"/></WrapPanel>
     </StackPanel>
    </ui:CardExpander>
    <ui:TextBlock Text="外观与交互" FontTypography="BodyStrong" Margin="0,4,0,10"/>
    <ui:CardControl Icon="{ui:SymbolIcon WeatherMoon24}" Margin="0,0,0,8">
     <ui:CardControl.Header><StackPanel><ui:TextBlock Text="应用主题" FontTypography="BodyStrong"/><ui:TextBlock Text="使用组件库的浅色、深色与系统主题。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption"/></StackPanel></ui:CardControl.Header>
     <ComboBox ItemsSource="{Binding Appearance.Themes}" SelectedItem="{Binding Appearance.ThemeChoice}" Width="160" AutomationProperties.Name="应用主题"/>
    </ui:CardControl>
    <ui:CardControl Icon="{ui:SymbolIcon Eye24}" Margin="0,0,0,16">
     <ui:CardControl.Header><StackPanel><ui:TextBlock Text="减少动效" FontTypography="BodyStrong"/><ui:TextBlock Text="停用页面淡入；同时遵循系统动画偏好。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption"/></StackPanel></ui:CardControl.Header>
     <ui:ToggleSwitch IsChecked="{Binding Appearance.ReduceMotion}" AutomationProperties.Name="减少动效"/>
    </ui:CardControl>
    <ui:TextBlock Text="版本与更新" FontTypography="BodyStrong" Margin="0,4,0,10"/>
    <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,0,8">
     <ui:CardControl.Header><StackPanel><ui:TextBlock Text="启动时检查更新" FontTypography="BodyStrong"/><ui:TextBlock Text="{Binding VersionDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption"/></StackPanel></ui:CardControl.Header>
     <ui:ToggleSwitch IsChecked="{Binding AutoCheckUpdates}" AutomationProperties.Name="启动时自动检查更新"/>
    </ui:CardControl>
    <ui:Card Padding="20" Margin="0,0,0,16">
     <StackPanel><ui:TextBlock Text="{Binding UpdateState}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <WrapPanel><ui:Button Content="检查更新" Command="{Binding CheckUpdateCommand}" Margin="0,0,8,8"/><ui:Button Content="下载更新" Command="{Binding DownloadUpdateCommand}" IsEnabled="{Binding CanDownloadUpdate}" Margin="0,0,8,8"/><ui:Button Content="安装已校验的更新" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" Margin="0,0,0,8"/></WrapPanel>
     </StackPanel>
    </ui:Card>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <ui:Button DockPanel.Dock="Right" Content="保存设置" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Command="{Binding SaveSettingsCommand}"/>
   <ui:TextBlock Text="保存后将核对实际生效值，下次翻译使用新配置。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
  </DockPanel>
 </Grid>
</Page>
