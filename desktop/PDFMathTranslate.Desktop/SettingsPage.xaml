<Page x:Class="PDFMathTranslate.Desktop.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="资源与设置" Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,18" MaxWidth="880" HorizontalAlignment="Left">
    <TextBlock Text="资源与设置" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <TextBlock Text="翻译服务" FontSize="17" FontWeight="SemiBold"/>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="服务" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Services}" SelectedItem="{Binding Service}" AutomationProperties.Name="翻译服务"/>
      <TextBlock Grid.Row="1" Text="模型" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" AutomationProperties.Name="模型名称"/>
      <TextBlock Grid.Row="2" Text="API 地址" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BaseUrl,UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" AutomationProperties.Name="API 地址"/>
      <TextBlock Grid.Row="3" Text="API 密钥" VerticalAlignment="Center"/><StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"><PasswordBox x:Name="ApiKey" MinHeight="36" PasswordChanged="KeyChanged" AutomationProperties.Name="新的 API 密钥"/><TextBlock Text="{Binding ApiKeyState}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <Separator Margin="0,20,0,18"/>
    <TextBlock Text="资源与运行档位" FontSize="17" FontWeight="SemiBold"/>
    <WrapPanel Margin="0,12,0,10"><ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}" Width="180" AutomationProperties.Name="资源档位"/><TextBlock Text="请求 QPS" VerticalAlignment="Center" Margin="18,0,10,0"/><TextBox Text="{Binding Qps,UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="请求 QPS"/></WrapPanel>
    <TextBlock Text="{Binding EffectivePolicy}"/><TextBlock Text="文档并发、本地计算和远程请求分别限制。修改后保存，下个任务生效。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,12"/>
    <TextBlock Text="{Binding AssetsState}"/><ProgressBar Value="{Binding AssetsProgress}" Maximum="100" Height="5" Margin="0,8,0,10"/>
    <WrapPanel><Button Content="准备 / 重试资源" Command="{Binding PrepareAssetsCommand}"/><Button Content="取消资源准备" Command="{Binding CancelAssetsCommand}"/><Button Content="重试启动服务" Command="{Binding RestartServiceCommand}"/></WrapPanel>
    <Separator Margin="0,20,0,18"/>
    <TextBlock Text="保存与数据" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock Text="默认保存目录（重启后保留）" Margin="0,12,0,6"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="选择目录…" Click="ChooseFolder" Margin="10,0,0,0"/><TextBox Text="{Binding SaveDirectory,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="默认保存目录"/></DockPanel>
    <TextBlock Text="按「PDF名_日期」建目录，同日多次保存自动生成版本，已有文件不会被覆盖。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,12"/>
    <TextBlock Text="应用数据目录" FontWeight="SemiBold"/><TextBlock Text="{Binding DataDirectory}" FontSize="12" Margin="0,6,0,0"/>
    <TextBlock Text="卸载默认保留设置、历史、下载记录和用户导出文件。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,16"/>
    <WrapPanel><ui:Button Content="保存设置并核对生效值" Appearance="Primary" Command="{Binding SaveSettingsCommand}" Click="SaveClicked"/><Button Content="重试待同步操作" Command="{Binding ResumePendingCommand}"/><Button Content="清除待同步记录…" Command="{Binding DismissPendingCommand}"/><Button Content="检查更新" Command="{Binding CheckUpdateCommand}"/></WrapPanel>
    <TextBlock Text="开发预览 · .NET 10 / WPF UI · 正式更新源停用" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,16,0,0"/>
    <TextBlock Text="{Binding UpdateState}" Margin="0,8,0,8"/><WrapPanel><Button Content="下载更新" Command="{Binding DownloadUpdateCommand}" IsEnabled="{Binding CanDownloadUpdate}"/><Button Content="安装已校验的更新" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}"/></WrapPanel>
  </StackPanel></ScrollViewer>
</Page>
