<Page x:Class="PDFMathTranslate.Desktop.WorkbenchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="工作台" Background="Transparent" AllowDrop="True" Drop="FilesDropped">
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="导入 PDF  (Ctrl+O)" Click="ImportClicked"/><StackPanel><TextBlock Text="文档翻译" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="保留公式与排版，确认语言后加入队列。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="待翻译文档 · 可将 PDF 拖到此处" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" MaxHeight="116" MinHeight="60" AutomationProperties.Name="待翻译文件">
          <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><TextBlock DockPanel.Dock="Right" Text="{Binding Pages,StringFormat={}{0} 页}" Margin="12,0,0,0"/><TextBlock Text="{Binding Filename}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Filename}"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Margin="0,12,0,0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
          <Grid><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><Image x:Name="Preview" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="PDF 页面预览"/></ScrollViewer><TextBlock x:Name="PreviewMessage" Text="导入 PDF 后按需预览页面" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/></Grid>
        </Border>
        <WrapPanel Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Center">
          <Button Content="上一页" Click="PreviousPage"/><TextBox x:Name="PageNumber" Text="1" Width="52" AutomationProperties.Name="预览页码" KeyDown="PageKeyDown"/><TextBlock x:Name="PageCount" Text=" / 0" VerticalAlignment="Center" Margin="4,0,10,0"/><Button Content="下一页" Click="NextPage"/>
          <CheckBox x:Name="OutputPreview" Content="预览选中任务的译文" Checked="PreviewModeChanged" Unchecked="PreviewModeChanged" VerticalAlignment="Center"/>
        </WrapPanel>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="翻译选项" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="源语言" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SourceLanguage}" AutomationProperties.Name="源语言"/>
          <TextBlock Text="目标语言" Margin="0,14,0,6" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding TargetLanguage}" AutomationProperties.Name="目标语言"/>
          <TextBlock Text="{Binding LanguageSummary}" Margin="0,8,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
          <TextBlock Text="翻译服务" Margin="0,16,0,6"/><ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding Service}" IsEnabled="False" AutomationProperties.Name="当前翻译服务"/><TextBlock Text="服务、密钥与模型在「资源与设置」中修改。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
          <TextBlock Text="输出内容" Margin="0,16,0,6"/><WrapPanel><CheckBox Content="双语对照" IsChecked="{Binding Dual}" Margin="0,0,14,0"/><CheckBox Content="单语译文" IsChecked="{Binding Mono}"/></WrapPanel>
          <CheckBox Content="自动提取术语" IsChecked="{Binding AutoTerms}" Margin="0,10,0,0"/>
          <TextBlock Text="页码范围（留空为全部）" Margin="0,16,0,6"/><TextBox Text="{Binding Pages,UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 1,3,5-10" AutomationProperties.Name="翻译页码范围"/>
          <TextBlock Text="默认保存目录" Margin="0,16,0,6"/><TextBlock Text="{Binding SaveDirectory}" ToolTip="{Binding SaveDirectory}" FontSize="12"/>
          <Button Content="选择本次保存目录…" Click="TaskFolderClicked" Margin="0,8,0,0"/><TextBox Text="{Binding TaskDirectory,UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" ToolTip="留空则使用默认保存目录" AutomationProperties.Name="本次保存目录"/>
          <TextBlock Text="{Binding EffectivePolicy}" FontSize="12" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
      <DockPanel><ui:Button DockPanel.Dock="Right" Content="开始翻译" Appearance="Primary" Command="{Binding SubmitCommand}"/><StackPanel><TextBlock Text="{Binding SelectedTask.Stage}" FontWeight="SemiBold"/><ProgressBar Value="{Binding SelectedTask.Progress,Mode=OneWay}" Maximum="100" Height="4" MinWidth="180" Margin="0,8,18,4"/><TextBlock Text="{Binding AssetsState}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></DockPanel>
    </Border>
  </Grid>
</Page>
