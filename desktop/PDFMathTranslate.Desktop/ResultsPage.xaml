<Page x:Class="PDFMathTranslate.Desktop.ResultsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:xf="clr-namespace:XamlFlair;assembly=XamlFlair.WPF"
 Title="文档输出" Background="Transparent">
 <Grid Margin="24,16,24,12" xf:Animations.Primary="{Binding Appearance.EntranceAnimation}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <ui:Button DockPanel.Dock="Right" Content="保存选中结果" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Command="{Binding ExportCommand}" VerticalAlignment="Center"/>
   <StackPanel><ui:TextBlock Text="文档输出" FontTypography="Title"/><ui:TextBlock Text="查看译文和保存版本，已有文件始终保留。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="200"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*" MinWidth="300"/></Grid.ColumnDefinitions>
   <ui:Card Padding="16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ui:TextBlock Text="文章记录" FontTypography="BodyStrong" Margin="0,0,0,12"/>
     <ListBox x:Name="CompletedTasks" Grid.Row="1" SelectedItem="{Binding SelectedTask,Mode=OneWay}" SelectionChanged="TaskSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" AutomationProperties.Name="按文章归组的翻译记录">
      <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><StackPanel Margin="0,12,0,6"><DockPanel><ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0"/><ui:TextBlock Text="{Binding Items[0].ArticleTitle}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis"/></DockPanel><ui:TextBlock Text="{Binding ItemCount,StringFormat=共 {0} 次翻译}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/></StackPanel></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><DockPanel><ui:TextBlock Text="{Binding CreatedLabel}" FontTypography="BodyStrong"/><ui:TextBlock Text="{Binding StatusLabel}" FontTypography="Caption" Margin="8,0,0,0" VerticalAlignment="Center"/></DockPanel><ui:TextBlock Text="{Binding Languages}" FontTypography="Caption" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ui:Button Grid.Row="2" Content="更多历史" Icon="{ui:SymbolIcon History24}" Command="{Binding MoreHistoryCommand}" Margin="0,12,0,0"/>
    </Grid>
   </ui:Card>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,4,0">
     <ui:Card Padding="16" Margin="0,0,0,12">
      <StackPanel>
       <ui:TextBlock Text="本次保存" FontTypography="BodyStrong" Margin="0,0,0,12"/>
       <WrapPanel><ui:ToggleSwitch Content="双语对照" IsChecked="{Binding ExportDual,Mode=TwoWay}" IsEnabled="{Binding HasDualOutput}" Margin="0,0,16,12"/><ui:ToggleSwitch Content="仅译文" IsChecked="{Binding ExportMono,Mode=TwoWay}" IsEnabled="{Binding HasMonoOutput}" Margin="0,0,16,12"/><ui:ToggleSwitch Content="术语表" IsChecked="{Binding ExportGlossary,Mode=TwoWay}" Visibility="{Binding HasGlossaryOutput,Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,12"/></WrapPanel>
       <ui:ToggleSwitch Content="直接保存到源 PDF 旁边" IsChecked="{Binding ExportToSource,Mode=TwoWay}" IsEnabled="{Binding HasSourceDirectory}" Margin="0,0,0,12"/>
       <Grid Visibility="{Binding ExportToSource,Converter={StaticResource VisibleWhenFalse}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBox Text="{Binding ExportDirectory,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="选择本次结果保存目录" AutomationProperties.Name="本次结果保存目录"/><ui:Button Grid.Column="1" Content="更改" Click="ChooseExportFolder" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0"/></Grid>
       <ui:TextBlock Text="{Binding ExportDestination}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <ui:Button Content="改用当前默认目录" Command="{Binding UseDefaultExportDirectoryCommand}" Appearance="Transparent" Margin="0,8,0,0"/>
      </StackPanel>
     </ui:Card>
     <ui:Card Padding="20" Margin="0,0,0,16">
      <StackPanel>
       <DockPanel><ui:Badge DockPanel.Dock="Right" Content="{Binding SelectedTask.StatusLabel,TargetNullValue=等待文档,FallbackValue=等待文档}" Appearance="{Binding SelectedTask.Status,Converter={StaticResource TaskAppearance},FallbackValue=Light}"/><ui:TextBlock Text="译文与版本" FontTypography="Subtitle"/></DockPanel>
       <ui:TextBlock Text="{Binding SelectedTask.Filename,TargetNullValue=暂无已完成文档,FallbackValue=暂无已完成文档}" FontTypography="BodyStrong" TextWrapping="Wrap" Margin="0,16,0,6"/>
       <ui:TextBlock Text="{Binding SelectedTask.Languages}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption"/>
       <ui:TextBlock Text="本次只保存勾选的类型。源目录模式与 PDF 放在一起；重名文件生成新版本。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
     </ui:Card>
     <ItemsControl ItemsSource="{Binding SelectedTask.SavedFiles}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <ui:Card Padding="16" Margin="0,0,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="28" VerticalAlignment="Top" Margin="0,4,12,0"/>
         <StackPanel Grid.Column="1">
          <ui:TextBlock Text="{Binding Filename}" FontTypography="BodyStrong" TextWrapping="Wrap"/>
          <ui:TextBlock Text="{Binding Format}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,8"/>
          <ui:TextBlock Text="{Binding FullPath}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" ToolTip="{Binding FullPath}"/>
          <WrapPanel Margin="0,12,0,0"><ui:Button Content="打开文件" Icon="{ui:SymbolIcon DocumentCopy24}" Tag="{Binding FullPath}" Click="OpenFileClicked" Margin="0,0,8,4"/><ui:Button Content="所在目录" Icon="{ui:SymbolIcon FolderOpen24}" Tag="{Binding FullPath}" Click="OpenFolderClicked" Margin="0,0,0,4"/></WrapPanel>
         </StackPanel>
        </Grid>
       </ui:Card>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <ui:Card Padding="32" Visibility="{Binding SelectedTask.SavedFiles.Count,Converter={StaticResource VisibleWhenEmpty}}">
      <StackPanel><ui:SymbolIcon Symbol="FolderOpen24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><ui:TextBlock Text="保存后，版本文件会出现在这里" FontTypography="BodyStrong" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,8"/><ui:TextBlock Text="选择已完成的任务，再点击「保存选中结果」。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
     </ui:Card>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Page>
